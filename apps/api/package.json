{
  "name": "@inventory/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "migration:run": "ts-node -r tsconfig-paths/register src/database/run-migrations.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "seed:demo-inventory": "ts-node -r tsconfig-paths/register src/database/seed-demo-inventory.ts",
    "seed:functional-warehouse": "ts-node -r tsconfig-paths/register src/database/seed-functional-warehouse.ts",
    "test:functional-warehouse": "ts-node -r tsconfig-paths/register src/database/run-functional-warehouse-tests.ts",
    "test:seed-bom-selector": "ts-node -r tsconfig-paths/register src/database/seed-bom-selector-test.ts",
    "test:cleanup-bom-selector": "ts-node -r tsconfig-paths/register src/database/cleanup-bom-selector-test.ts",
    "inventory:reconcile": "ts-node -r tsconfig-paths/register src/database/reconcile-inventory.ts",
    "test:upgrade": "ts-node -r tsconfig-paths/register test/upgrade-migration.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.5.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
